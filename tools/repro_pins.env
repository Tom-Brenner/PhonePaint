# Sourced by setup_from_clone.sh / create_*.sh. Pin external git + pip extras
# that cannot live in environment-*.yml alone. Bump intentionally.
#
# shellcheck shell=bash

# BFA / phonemizer (installed with --no-deps in create_unified_env.sh)
BFA_VERSION=1.1.5
PHONEMIZER_FORK_VERSION=3.3.2

# CrisperWhisper transformers fork (nyrahealth); commit of branch crisper_whisper
CRISPER_TRANSFORMERS_GIT=git+https://github.com/nyrahealth/transformers.git@8eb900e81d43576d2ddf69cceb1c2bb8b0330bc1

# FALCON vendor (also mirrored in tools/falcon/VENDOR_PIN)
FALCON_GIT_REPO=https://github.com/MLSpeech/FALCON.git
FALCON_GIT_REF=3d6e3d876ebaf2472757720d92222d55dd7410f8
FALCON_HF_REPO=MLSpeech/FALCON-weights

# VoiceCraft EnCodec (audiocraft sources + SEANet checkpoint)
VOICECRAFT_GIT_REPO=https://github.com/jasonppy/VoiceCraft.git
VOICECRAFT_GIT_REF=master
VOICECRAFT_ENCODEC_HF_REPO=pyp1/VoiceCraft
VOICECRAFT_ENCODEC_FILE=encodec_4cb2048_giga.th
# audiocraft is NOT part of the VoiceCraft repo; it is cloned into
# VOICECRAFT_ROOT/src/audiocraft (SEANet modules loaded by voicecraft_encodec.py).
AUDIOCRAFT_GIT_REPO=https://github.com/facebookresearch/audiocraft.git
AUDIOCRAFT_GIT_REF=c5157b5bf14bf83449c17ea1eeb66c19fb4bc7f0
